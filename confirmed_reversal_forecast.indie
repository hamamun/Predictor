                                            rev_volume_feature = rev_volume_ratio
                                            rev_trend_feature = rev_bear_trend
                                            rev_location_feature = (rev_swing_high - rev_high) / rev_atr
                                        if rev_direction == -hist_direction and rev_pattern > 0 and not isnan(rev_break_level):
                                            opp_pending_direction = rev_direction
                                            opp_pending_break = rev_break_level
                                            opp_pending_age = 0
                                if not opposite_found:
                                    episode_duration = float(max_horizon)
                                triggered_move_sum += best_favorable * similarity
                                triggered_duration_sum += episode_duration * similarity
                                triggered_duration2_sum += episode_duration * episode_duration * similarity
                                if outcome_decided and trade_success:
                                    successful_weight += similarity

            if total_weight > 0.0:
                confidence = 100.0 * successful_weight / total_weight
            if triggered_weight > 0.0:
                expected_move_atr = triggered_move_sum / triggered_weight
                expected_bars = triggered_duration_sum / triggered_weight
                duration_variance = triggered_duration2_sum / triggered_weight - expected_bars * expected_bars
                if duration_variance < 0.0:
                    duration_variance = 0.0
                duration_root = duration_variance
                if duration_root < 1.0:
                    duration_root = 1.0
                for q in range(12):
                    duration_root = (duration_root + duration_variance / duration_root) * 0.5
                duration_spread = duration_root * 0.75
                if duration_spread < 1.0:
                    duration_spread = 1.0
                duration_low = float(int(expected_bars - duration_spread + 0.5))
                duration_high = float(int(expected_bars + duration_spread + 0.5))
                if duration_low < 1.0:
                    duration_low = 1.0
                if duration_high > float(max_horizon):
                    duration_high = float(max_horizon)
                if duration_high <= duration_low:
                    duration_high = duration_low + 1.0
                if duration_high > float(max_horizon):
                    duration_high = float(max_horizon)
            risk_in_atr = abs(signal_entry - signal_stop) / signal_atr
            estimate_available = analog_count >= 2 and triggered_weight > 0.0 and expected_move_atr > 0.0 and expected_bars > 0.0 and duration_high > 0.0
            if estimate_available:
                target_level = signal_entry + float(signal_direction) * expected_move_atr * signal_atr
                forecast_ready = analog_count >= minimum_analogs and confidence >= float(minimum_followthrough_pct) and expected_move_atr >= risk_in_atr * minimum_reward_risk
                reason_code = 5.0
                if not forecast_ready:
                    if analog_count < minimum_analogs:
                        reason_code = 2.0
                    elif confidence < float(minimum_followthrough_pct):
                        reason_code = 3.0
                    elif expected_move_atr < risk_in_atr * minimum_reward_risk:
                        reason_code = 4.0
            else:
                reason_code = 1.0

            # Store the latest confirmed event for the dashboard even when no
            # historical estimate is available. A weak estimate remains visible.
            forecast_direction_state[0] = float(signal_direction)
            forecast_pattern_state[0] = float(signal_pattern)
            forecast_variant_state[0] = float(signal_variant)
            forecast_entry_state[0] = signal_entry
            forecast_stop_state[0] = signal_stop
            forecast_target_state[0] = target_level
            forecast_confidence_state[0] = confidence
            forecast_analogs_state[0] = float(analog_count)
            forecast_bars_state[0] = expected_bars
            forecast_low_state[0] = duration_low
            forecast_high_state[0] = duration_high
            forecast_move_state[0] = expected_move_atr
            forecast_reason_state[0] = reason_code
            forecast_estimate_state[0] = 1.0 if estimate_available else 0.0
            break_plot = True
            if estimate_available:
                if last_result_state[0] == 6.0:
                    last_result_state[0] = 0.0
                entry_state[0] = signal_entry
                stop_state[0] = signal_stop
                target_state[0] = target_level
                direction_state[0] = float(signal_direction)
                remaining_state[0] = duration_high
            else:
                last_result_state[0] = 6.0

        # Start one unconfirmed candidate per swing. A direction-specific cooldown
        # groups nearby patterns; an opposite-direction candidate remains possible.
        if not skip_new_candidate_bar and pending_direction_state[0] == 0.0 and cur_direction != 0 and cur_atr_feature > 0.0 and not isnan(cur_break_level) and not isnan(cur_stop_level):
            candidate_allowed = False
            if cur_direction > 0 and bull_cooldown_state[0] <= 0.0:
                candidate_allowed = True
            elif cur_direction < 0 and bear_cooldown_state[0] <= 0.0:
                candidate_allowed = True
            if candidate_allowed:
                pending_direction_state[0] = float(cur_direction)
                pending_break_state[0] = cur_break_level
                pending_stop_state[0] = cur_stop_level
                pending_pattern_state[0] = float(cur_pattern)
                pending_variant_state[0] = float(cur_variant)
                pending_atr_state[0] = cur_atr_feature
                pending_volume_state[0] = cur_volume_feature
                pending_trend_state[0] = cur_trend_feature
                pending_location_state[0] = cur_location_feature
                pending_elapsed_state[0] = 0.0
                pending_marker_state[0] = cur_marker_level
                if cur_direction > 0:
                    bull_cooldown_state[0] = float(swing_length + confirmation_bars)
                else:
                    bear_cooldown_state[0] = float(swing_length + confirmation_bars)
                candidate_marker = cur_marker_level

    if self.is_last_bar:
        pattern_main_text = '--'
        pattern_main_text_code = int(forecast_pattern_state[0] + 0.5)
        pattern_main_text_variant = int(forecast_variant_state[0] + 0.5)
        if pattern_main_text_code == 1:
            if pattern_main_text_variant == 11:
                pattern_main_text = 'Bullish engulfing'
            elif pattern_main_text_variant == 12:
                pattern_main_text = 'Bearish engulfing'
            else:
                pattern_main_text = 'Engulfing'
        elif pattern_main_text_code == 2:
            if pattern_main_text_variant == 21:
                pattern_main_text = 'Hammer'
            elif pattern_main_text_variant == 22:
                pattern_main_text = 'Inverted hammer'
            elif pattern_main_text_variant == 23:
                pattern_main_text = 'Hanging man'
            elif pattern_main_text_variant == 24:
                pattern_main_text = 'Shooting star'
            else:
                pattern_main_text = 'Hammer family'
        elif pattern_main_text_code == 3:
            if pattern_main_text_variant == 31:
                pattern_main_text = 'Morning star'
            elif pattern_main_text_variant == 32:
                pattern_main_text = 'Evening star'
            elif pattern_main_text_variant == 33:
                pattern_main_text = 'Morning doji star'
            elif pattern_main_text_variant == 34:
                pattern_main_text = 'Evening doji star'
            else:
                pattern_main_text = 'Star (incl. doji)'
        pattern_pending_text = '--'
        pattern_pending_text_code = int(pending_pattern_state[0] + 0.5)
        pattern_pending_text_variant = int(pending_variant_state[0] + 0.5)
        if pattern_pending_text_code == 1:
            if pattern_pending_text_variant == 11:
                pattern_pending_text = 'Bullish engulfing'
            elif pattern_pending_text_variant == 12:
                pattern_pending_text = 'Bearish engulfing'
            else:
                pattern_pending_text = 'Engulfing'
        elif pattern_pending_text_code == 2:
            if pattern_pending_text_variant == 21:
                pattern_pending_text = 'Hammer'
            elif pattern_pending_text_variant == 22:
                pattern_pending_text = 'Inverted hammer'
            elif pattern_pending_text_variant == 23:
                pattern_pending_text = 'Hanging man'
            elif pattern_pending_text_variant == 24:
                pattern_pending_text = 'Shooting star'
            else:
                pattern_pending_text = 'Hammer family'
        elif pattern_pending_text_code == 3:
            if pattern_pending_text_variant == 31:
                pattern_pending_text = 'Morning star'
            elif pattern_pending_text_variant == 32:
                pattern_pending_text = 'Evening star'
            elif pattern_pending_text_variant == 33:
                pattern_pending_text = 'Morning doji star'
            elif pattern_pending_text_variant == 34:
                pattern_pending_text = 'Evening doji star'
            else:
                pattern_pending_text = 'Star (incl. doji)'
        pattern_last_text = '--'
        pattern_last_text_code = int(last_pattern_state[0] + 0.5)
        pattern_last_text_variant = int(last_variant_state[0] + 0.5)
        if pattern_last_text_code == 1:
            if pattern_last_text_variant == 11:
                pattern_last_text = 'Bullish engulfing'
            elif pattern_last_text_variant == 12:
                pattern_last_text = 'Bearish engulfing'
            else:
                pattern_last_text = 'Engulfing'
        elif pattern_last_text_code == 2:
            if pattern_last_text_variant == 21:
                pattern_last_text = 'Hammer'
            elif pattern_last_text_variant == 22:
                pattern_last_text = 'Inverted hammer'
            elif pattern_last_text_variant == 23:
                pattern_last_text = 'Hanging man'
            elif pattern_last_text_variant == 24:
                pattern_last_text = 'Shooting star'
            else:
                pattern_last_text = 'Hammer family'
        elif pattern_last_text_code == 3:
            if pattern_last_text_variant == 31:
                pattern_last_text = 'Morning star'
            elif pattern_last_text_variant == 32:
                pattern_last_text = 'Evening star'
            elif pattern_last_text_variant == 33:
                pattern_last_text = 'Morning doji star'
            elif pattern_last_text_variant == 34:
                pattern_last_text = 'Evening doji star'
            else:
                pattern_last_text = 'Star (incl. doji)'

        side_text = '--'
        if direction_state[0] != 0.0 and remaining_state[0] > 0.0:
            side_text = 'BUY' if forecast_direction_state[0] > 0.0 else 'SELL'
        elif pending_direction_state[0] != 0.0:
            side_text = 'BUY' if pending_direction_state[0] > 0.0 else 'SELL'
        elif last_direction_state[0] != 0.0:
            side_text = 'BUY' if last_direction_state[0] > 0.0 else 'SELL'
        pattern_text = '--'
        if direction_state[0] != 0.0 and remaining_state[0] > 0.0:
            pattern_text = pattern_main_text
        elif pending_direction_state[0] != 0.0:
            pattern_text = pattern_pending_text
        elif last_direction_state[0] != 0.0:
            pattern_text = pattern_last_text

        pending_left = confirmation_bars - int(pending_elapsed_state[0] + 0.5)
        if pending_left < 1:
            pending_left = 1
        pending_text = '--'
        if pending_direction_state[0] != 0.0:
            pending_side = 'BUY' if pending_direction_state[0] > 0.0 else 'SELL'
            pending_text = pending_side + ' ' + pattern_pending_text + ' (' + str(pending_left) + ' bars left)'

        result_text = '--'
        result_code = int(last_result_state[0] + 0.5)
        if result_code == 1:
            result_text = 'TP estimate reached'
        elif result_code == 2:
            result_text = 'Stop loss touched'
        elif result_code == 3:
            result_text = 'Opposite confirmed reversal'
        elif result_code == 4:
            result_text = 'Duration limit reached; no extension'
        elif result_code == 5:
            result_text = 'Replaced by newer signal'
        elif result_code == 6:
            result_text = 'No historical estimate'

        status_text = 'No recent confirmed reversal'
        if direction_state[0] != 0.0 and remaining_state[0] > 0.0:
            status_text = 'Forecast active | monitoring closed candles'
            if pending_direction_state[0] != 0.0:
                pending_side = 'BUY' if pending_direction_state[0] > 0.0 else 'SELL'
                status_text = 'Forecast active | ' + pending_side + ' candidate waiting (' + str(pending_left) + ' bars)'
        elif pending_direction_state[0] != 0.0:
            pending_side = 'BUY' if pending_direction_state[0] > 0.0 else 'SELL'
            status_text = pending_side + ' candidate | waiting confirmation (' + str(pending_left) + ' bars)'
        elif result_code == 6:
            status_text = 'Confirmed reversal | no historical estimate'
        elif result_code > 0:
            status_text = 'Forecast ended | ' + result_text
        elif forecast_estimate_state[0] > 0.5:
            status_text = 'Forecast ended; estimate retained'

        quality_text = 'No historical estimate'
        if forecast_estimate_state[0] > 0.5:
            quality_code = int(forecast_reason_state[0] + 0.5)
            if quality_code == 2:
                quality_text = 'Low sample count'
            elif quality_code == 3:
                quality_text = 'Below follow-through filter'
            elif quality_code == 4:
                quality_text = 'Below reward/risk filter'
            elif quality_code == 5:
                quality_text = 'Meets selected filters'

        entry_text = '--'
        stop_text = '--'
        target_text = '--'
        move_text = '--'
        bars_text = '--'
        history_text = '--'
        expiry_text = '--'
        if direction_state[0] != 0.0 and remaining_state[0] > 0.0:
            if not isnan(forecast_entry_state[0]):
                entry_text = str(round(forecast_entry_state[0], self.info.price_precision))
            if not isnan(forecast_stop_state[0]):
                stop_text = str(round(forecast_stop_state[0], self.info.price_precision))
            if forecast_estimate_state[0] > 0.5:
                target_text = str(round(forecast_target_state[0], self.info.price_precision))
                move_text = '+' + str(round(forecast_move_state[0], 2)) + ' ATR'
                bars_text = str(int(forecast_bars_state[0] + 0.5)) + ' bars (' + str(int(forecast_low_state[0] + 0.5)) + '-' + str(int(forecast_high_state[0] + 0.5)) + ')'
                history_text = str(int(forecast_confidence_state[0] + 0.5)) + '% | ' + str(int(forecast_analogs_state[0] + 0.5)) + ' samples'
            expiry_text = str(int(remaining_state[0] + 0.5)) + ' bars'
        elif pending_direction_state[0] != 0.0:
            if not isnan(pending_break_state[0]):
                entry_text = str(round(pending_break_state[0], self.info.price_precision))
            if not isnan(pending_stop_state[0]):
                stop_text = str(round(pending_stop_state[0], self.info.price_precision))
            target_text = 'Awaiting confirmation'
        elif forecast_estimate_state[0] > 0.5:
            if not isnan(forecast_entry_state[0]):
                entry_text = str(round(forecast_entry_state[0], self.info.price_precision))
            if not isnan(forecast_stop_state[0]):
                stop_text = str(round(forecast_stop_state[0], self.info.price_precision))
            if not isnan(forecast_target_state[0]):
                target_text = str(round(forecast_target_state[0], self.info.price_precision))
            move_text = '+' + str(round(forecast_move_state[0], 2)) + ' ATR'
            bars_text = str(int(forecast_bars_state[0] + 0.5)) + ' bars (' + str(int(forecast_low_state[0] + 0.5)) + '-' + str(int(forecast_high_state[0] + 0.5)) + ')'
            history_text = str(int(forecast_confidence_state[0] + 0.5)) + '% | ' + str(int(forecast_analogs_state[0] + 0.5)) + ' samples'

        dashboard.get().clear()
        dashboard.get().append(TableRow([
            TableCell('CONFIRMED REVERSAL FORECAST', bg_color=color.NAVY(0.90)),
            TableCell(side_text, bg_color=color.NAVY(0.90)),
        ]))
        dashboard.get().add_row(['Status', status_text])
        dashboard.get().add_row(['Pattern', pattern_text])
        dashboard.get().add_row(['Pending candidate', pending_text])
        dashboard.get().add_row(['Entry / trigger', entry_text])
        dashboard.get().add_row(['Stop loss', stop_text])
        dashboard.get().add_row(['TP estimate', target_text])
        dashboard.get().add_row(['Expected move', move_text])
        dashboard.get().add_row(['Expected duration', bars_text])
        dashboard.get().add_row(['Estimate quality', quality_text])
        dashboard.get().add_row(['Historical follow-through / samples', history_text])
        dashboard.get().add_row(['Forecast expires in', expiry_text])
        dashboard.get().add_row(['Last result', result_text])
        self.chart.draw(dashboard.get())

    # Break level plots on a new confirmed signal. Step plots keep active levels
    # horizontal and NaN values separate unrelated forecasts.
    entry_plot = entry_state[0]
    stop_plot = stop_state[0]
    target_plot = target_state[0]
    if break_plot:
        entry_plot = nan
        stop_plot = nan
        target_plot = nan

    return (
        plot.Marker(candidate_marker, color=color.YELLOW, offset=-1),
        plot.Marker(confirmed_bull_marker, color=color.GREEN, offset=-1),
        plot.Marker(confirmed_bear_marker, color=color.RED, offset=-1),
        plot.Steps(entry_plot),
        plot.Steps(stop_plot),
        plot.Steps(target_plot),
    )