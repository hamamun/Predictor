# indie:lang_version = 5
# Confirmed Reversal Forecast — Exness Terminal / Indie
# A separate variant of reversal_forecast.indie. The original file is unchanged.
# All signal, confirmation, historical-analog and forecast updates use CLOSED candles.
from math import nan, isnan
from indie import indicator, param, plot, color, MutSeriesF, Var
from indie.drawings import Table, TableCell, TableRow, RelativePosition, vertical_anchor as va, horizontal_anchor as ha


@indicator('Confirmed Reversal Forecast (Historical Analogs)', overlay_main_pane=True)
@param.int('history_bars', default=600, min=100, max=2000, title='Historical lookback bars')
@param.int('max_horizon', default=24, min=4, max=100, title='Maximum forecast horizon (bars)')
@param.int('atr_length', default=14, min=2, max=100, title='ATR length')
@param.int('trend_length', default=12, min=2, max=100, title='Prior trend length')
@param.int('volume_length', default=20, min=2, max=200, title='Volume baseline length')
@param.int('swing_length', default=20, min=3, max=200, title='Swing context length')
@param.int('minimum_analogs', default=6, min=2, max=50, title='Minimum similar historical setups')
@param.int('minimum_followthrough_pct', default=55, min=1, max=99, title='Minimum historical follow-through percent')
@param.float('minimum_reward_risk', default=1.2, min=0.5, max=5.0, step=0.1, title='Minimum forecast reward/risk')
@plot.marker(title='Reversal candidate (unconfirmed)', style=plot.marker_style.CIRCLE, position=plot.marker_position.BELOW, size=1)
@plot.marker(title='Confirmed bullish reversal', style=plot.marker_style.CIRCLE, position=plot.marker_position.BELOW, size=2)
@plot.marker(title='Confirmed bearish reversal', style=plot.marker_style.CIRCLE, position=plot.marker_position.ABOVE, size=2)
@plot.steps(title='Forecast entry', color=color.AQUA, line_width=1)
@plot.steps(title='Forecast stop loss', color=color.RED, line_width=1)
@plot.steps(title='Forecast TP estimate', color=color.YELLOW, line_width=1)
def Main(self, history_bars, max_horizon, atr_length, trend_length, volume_length, swing_length, minimum_analogs, minimum_followthrough_pct, minimum_reward_risk):
    # Fixed, ATR-normalized rules keep the confirmed version focused:
    # three pattern families, meaningful prior move, swing location, two-bar
    # confirmation, one signal per swing, and no rolling TP extensions.
    minimum_trend_atr = 1.0
    swing_tolerance_atr = 1.0
    confirmation_bars = 2

    entry_state = MutSeriesF.new(init=nan)
    stop_state = MutSeriesF.new(init=nan)
    target_state = MutSeriesF.new(init=nan)
    direction_state = MutSeriesF.new(init=0.0)
    remaining_state = MutSeriesF.new(init=0.0)
    pending_direction_state = MutSeriesF.new(init=0.0)
    pending_break_state = MutSeriesF.new(init=nan)
    pending_stop_state = MutSeriesF.new(init=nan)
    pending_pattern_state = MutSeriesF.new(init=0.0)
    pending_variant_state = MutSeriesF.new(init=0.0)
    pending_atr_state = MutSeriesF.new(init=0.0)
    pending_volume_state = MutSeriesF.new(init=1.0)
    pending_trend_state = MutSeriesF.new(init=0.0)
    pending_location_state = MutSeriesF.new(init=0.0)
    pending_elapsed_state = MutSeriesF.new(init=0.0)
    pending_marker_state = MutSeriesF.new(init=nan)
    bull_cooldown_state = MutSeriesF.new(init=0.0)
    bear_cooldown_state = MutSeriesF.new(init=0.0)
    forecast_direction_state = MutSeriesF.new(init=0.0)
    forecast_pattern_state = MutSeriesF.new(init=0.0)
    forecast_variant_state = MutSeriesF.new(init=0.0)
    forecast_entry_state = MutSeriesF.new(init=nan)
    forecast_stop_state = MutSeriesF.new(init=nan)
    forecast_target_state = MutSeriesF.new(init=nan)
    forecast_confidence_state = MutSeriesF.new(init=0.0)
    forecast_analogs_state = MutSeriesF.new(init=0.0)
    forecast_bars_state = MutSeriesF.new(init=0.0)
    forecast_low_state = MutSeriesF.new(init=0.0)
    forecast_high_state = MutSeriesF.new(init=0.0)
    forecast_move_state = MutSeriesF.new(init=0.0)
    forecast_estimate_state = MutSeriesF.new(init=0.0)
    forecast_reason_state = MutSeriesF.new(init=1.0)
    last_direction_state = MutSeriesF.new(init=0.0)
    last_pattern_state = MutSeriesF.new(init=0.0)
    last_variant_state = MutSeriesF.new(init=0.0)
    last_result_state = MutSeriesF.new(init=0.0)
    entry_state[0] = entry_state[1]
    stop_state[0] = stop_state[1]
    target_state[0] = target_state[1]
    direction_state[0] = direction_state[1]
    remaining_state[0] = remaining_state[1]
    pending_direction_state[0] = pending_direction_state[1]
    pending_break_state[0] = pending_break_state[1]
    pending_stop_state[0] = pending_stop_state[1]
    pending_pattern_state[0] = pending_pattern_state[1]
    pending_variant_state[0] = pending_variant_state[1]
    pending_atr_state[0] = pending_atr_state[1]
    pending_volume_state[0] = pending_volume_state[1]
    pending_trend_state[0] = pending_trend_state[1]
    pending_location_state[0] = pending_location_state[1]
    pending_elapsed_state[0] = pending_elapsed_state[1]
    pending_marker_state[0] = pending_marker_state[1]
    bull_cooldown_state[0] = bull_cooldown_state[1]
    bear_cooldown_state[0] = bear_cooldown_state[1]
    forecast_direction_state[0] = forecast_direction_state[1]
    forecast_pattern_state[0] = forecast_pattern_state[1]
    forecast_variant_state[0] = forecast_variant_state[1]
    forecast_entry_state[0] = forecast_entry_state[1]
    forecast_stop_state[0] = forecast_stop_state[1]
    forecast_target_state[0] = forecast_target_state[1]
    forecast_confidence_state[0] = forecast_confidence_state[1]
    forecast_analogs_state[0] = forecast_analogs_state[1]
    forecast_bars_state[0] = forecast_bars_state[1]
    forecast_low_state[0] = forecast_low_state[1]
    forecast_high_state[0] = forecast_high_state[1]
    forecast_move_state[0] = forecast_move_state[1]
    forecast_estimate_state[0] = forecast_estimate_state[1]
    forecast_reason_state[0] = forecast_reason_state[1]
    last_direction_state[0] = last_direction_state[1]
    last_pattern_state[0] = last_pattern_state[1]
    last_variant_state[0] = last_variant_state[1]
    last_result_state[0] = last_result_state[1]

    if bull_cooldown_state[0] > 0.0:
        bull_cooldown_state[0] = bull_cooldown_state[0] - 1.0
    if bear_cooldown_state[0] > 0.0:
        bear_cooldown_state[0] = bear_cooldown_state[0] - 1.0

    # Keep the dashboard at the chart's upper-left, below the indicator legend.
    dashboard = Var[Table].new(Table(
        position=RelativePosition(va.TOP, ha.LEFT, 0.11, 0.02),
    ))

    context_length = atr_length + 3
    if volume_length + 3 > context_length:
        context_length = volume_length + 3
    if trend_length + 3 > context_length:
        context_length = trend_length + 3
    if swing_length + 3 > context_length:
        context_length = swing_length + 3
    can_calculate = self.bar_count > context_length + 2

    cur_direction = 0
    cur_pattern = 0
    cur_variant = 0
    cur_break_level = nan
    cur_stop_level = nan
    cur_marker_level = nan
    cur_atr_feature = 0.0
    cur_volume_feature = 1.0
    cur_trend_feature = 0.0
    cur_location_feature = 0.0
    cur_bull_trend = 0.0
    cur_bear_trend = 0.0

    confirmed_signal = False
    confirmed_bull_marker = nan
    confirmed_bear_marker = nan
    candidate_marker = nan
    break_plot = False
    skip_new_candidate_bar = False

    signal_direction = 0
    signal_pattern = 0
    signal_variant = 0
    signal_break = nan
    signal_stop = nan
    signal_marker = nan
    signal_atr = 0.0
    signal_volume = 1.0
    signal_trend = 0.0
    signal_location = 0.0
    signal_entry = nan

    analog_count = 0
    total_weight = 0.0
    triggered_weight = 0.0
    successful_weight = 0.0
    triggered_move_sum = 0.0
    triggered_duration_sum = 0.0
    triggered_duration2_sum = 0.0
    confidence = 0.0
    expected_move_atr = 0.0
    expected_bars = 0.0
    duration_low = 1.0
    duration_high = float(max_horizon)
    estimate_available = False
    forecast_ready = False
    reason_code = 1.0
    target_level = nan
    risk_in_atr = 0.0

    if can_calculate:
        cur_open = self.open[1]
        cur_high = self.high[1]
        cur_low = self.low[1]
        cur_close = self.close[1]
        cur_prior_open = self.open[1 + 1]
        cur_prior_close = self.close[1 + 1]
        cur_first_open = self.open[1 + 2]
        cur_first_high = self.high[1 + 2]
        cur_first_low = self.low[1 + 2]
        cur_first_close = self.close[1 + 2]
        cur_middle_open = self.open[1 + 1]
        cur_middle_high = self.high[1 + 1]
        cur_middle_low = self.low[1 + 1]
        cur_middle_close = self.close[1 + 1]

        cur_range = cur_high - cur_low
        cur_body = abs(cur_close - cur_open)
        cur_body_low = cur_open
        cur_body_high = cur_close
        if cur_close < cur_open:
            cur_body_low = cur_close
            cur_body_high = cur_open
        cur_lower_wick = cur_body_low - cur_low
        cur_upper_wick = cur_high - cur_body_high

        cur_tr_sum = 0.0
        for k in range(atr_length):
            cur_shift = 1 + k
            cur_bar_range = self.high[cur_shift] - self.low[cur_shift]
            cur_prior_true_close = self.close[cur_shift + 1]
            cur_true_range = cur_bar_range
            if cur_prior_true_close > self.high[cur_shift]:
                cur_true_range = cur_prior_true_close - self.low[cur_shift]
            elif cur_prior_true_close < self.low[cur_shift]:
                cur_true_range = self.high[cur_shift] - cur_prior_true_close
            cur_tr_sum += cur_true_range
        cur_atr = 0.0
        if atr_length > 0:
            cur_atr = cur_tr_sum / float(atr_length)

        cur_volume_sum = 0.0
        for k in range(volume_length):
            cur_volume_sum += self.volume[1 + 1 + k]
        cur_average_volume = cur_volume_sum / float(volume_length)
        cur_volume_ratio = 1.0
        if cur_average_volume > 0.0 and self.volume[1] >= 0.0:
            cur_volume_ratio = self.volume[1] / cur_average_volume

        cur_trend_start = self.close[1 + trend_length]
        cur_trend_end = self.close[1 + 1]
        cur_swing_low = self.low[1 + 1]
        cur_swing_high = self.high[1 + 1]
        for k in range(1, swing_length):
            cur_swing_shift = 1 + 1 + k
            if self.low[cur_swing_shift] < cur_swing_low:
                cur_swing_low = self.low[cur_swing_shift]
            if self.high[cur_swing_shift] > cur_swing_high:
                cur_swing_high = self.high[cur_swing_shift]

        cur_bull_trend = 0.0
        cur_bear_trend = 0.0
        cur_bull_context = False
        cur_bear_context = False
        if cur_atr > 0.0:
            cur_bull_trend = (cur_trend_start - cur_trend_end) / cur_atr
            cur_bear_trend = (cur_trend_end - cur_trend_start) / cur_atr
            if cur_bull_trend >= minimum_trend_atr and cur_low <= cur_swing_low + swing_tolerance_atr * cur_atr:
                cur_bull_context = True
            if cur_bear_trend >= minimum_trend_atr and cur_high >= cur_swing_high - swing_tolerance_atr * cur_atr:
                cur_bear_context = True

        cur_small_body = cur_range > 0.0 and cur_body > 0.0 and cur_body <= cur_range * 0.35
        cur_lower_shape = cur_small_body and cur_lower_wick >= cur_body * 2.0 and cur_lower_wick >= cur_range * 0.50 and cur_body_low >= cur_low + cur_range * 0.65
        cur_upper_shape = cur_small_body and cur_upper_wick >= cur_body * 2.0 and cur_upper_wick >= cur_range * 0.50 and cur_body_high <= cur_low + cur_range * 0.35
        cur_bull_engulf = cur_bull_context and cur_close > cur_open and cur_prior_close < cur_prior_open and cur_open <= cur_prior_close and cur_close >= cur_prior_open and cur_body > 0.0
        cur_bear_engulf = cur_bear_context and cur_close < cur_open and cur_prior_close > cur_prior_open and cur_open >= cur_prior_close and cur_close <= cur_prior_open and cur_body > 0.0

        cur_first_range = cur_first_high - cur_first_low
        cur_first_body = abs(cur_first_close - cur_first_open)
        cur_first_mid = (cur_first_open + cur_first_close) * 0.5
        cur_middle_range = cur_middle_high - cur_middle_low
        cur_middle_body = abs(cur_middle_close - cur_middle_open)
        cur_third_range = cur_range
        cur_third_body = cur_body
        cur_star_low = cur_first_low
        cur_star_high = cur_first_high
        if cur_middle_low < cur_star_low:
            cur_star_low = cur_middle_low
        if cur_low < cur_star_low:
            cur_star_low = cur_low
        if cur_middle_high > cur_star_high:
            cur_star_high = cur_middle_high
        if cur_high > cur_star_high:
            cur_star_high = cur_high
        cur_doji_middle = cur_middle_range > 0.0 and cur_middle_body <= cur_middle_range * 0.10
        cur_small_middle = cur_middle_range > 0.0 and cur_first_body > 0.0 and cur_third_body > 0.0 and cur_middle_body <= cur_middle_range * 0.30 and cur_middle_body <= cur_first_body * 0.60 and cur_middle_body <= cur_third_body * 0.60
        cur_large_first = cur_first_range > 0.0 and cur_first_body >= cur_first_range * 0.50
        cur_large_third = cur_third_range > 0.0 and cur_third_body >= cur_third_range * 0.50
        cur_morning_star = cur_bull_context and cur_small_middle and cur_large_first and cur_large_third and cur_first_close < cur_first_open and cur_close > cur_open and cur_close >= cur_first_mid and cur_middle_low <= cur_first_low + cur_first_range * 0.25 and cur_middle_low <= cur_low + cur_third_range * 0.25
        cur_evening_star = cur_bear_context and cur_small_middle and cur_large_first and cur_large_third and cur_first_close > cur_first_open and cur_close < cur_open and cur_close <= cur_first_mid and cur_middle_high >= cur_first_high - cur_first_range * 0.25 and cur_middle_high >= cur_high - cur_third_range * 0.25

        cur_direction = 0
        cur_pattern = 0
        cur_variant = 0
        cur_break_level = nan
        cur_stop_level = nan
        cur_marker_level = nan
        cur_atr_feature = 0.0
        cur_volume_feature = 1.0
        cur_trend_feature = 0.0
        cur_location_feature = 0.0
        cur_bull_pattern = 0
        cur_bear_pattern = 0
        cur_bull_variant = 0
        cur_bear_variant = 0
        cur_bull_break = nan
        cur_bear_break = nan
        cur_bull_stop = nan
        cur_bear_stop = nan
        cur_bull_marker = nan
        cur_bear_marker = nan

        if cur_atr > 0.0:
            if cur_morning_star:
                cur_bull_pattern = 3
                cur_bull_break = cur_high
                cur_bull_stop = cur_star_low - cur_atr * 0.15
                cur_bull_marker = cur_star_low
                if cur_doji_middle:
                    cur_bull_variant = 33
                else:
                    cur_bull_variant = 31
            elif cur_bull_engulf:
                cur_bull_pattern = 1
                cur_bull_variant = 11
                cur_bull_break = cur_high
                cur_bull_stop = cur_low - cur_atr * 0.15
                cur_bull_marker = cur_low
            elif cur_bull_context and cur_lower_shape:
                cur_bull_pattern = 2
                cur_bull_variant = 21
                cur_bull_break = cur_high
                cur_bull_stop = cur_low - cur_atr * 0.15
                cur_bull_marker = cur_low
            elif cur_bull_context and cur_upper_shape:
                cur_bull_pattern = 2
                cur_bull_variant = 22
                cur_bull_break = cur_high
                cur_bull_stop = cur_low - cur_atr * 0.15
                cur_bull_marker = cur_low

            if cur_evening_star:
                cur_bear_pattern = 3
                cur_bear_break = cur_low
                cur_bear_stop = cur_star_high + cur_atr * 0.15
                cur_bear_marker = cur_star_high
                if cur_doji_middle:
                    cur_bear_variant = 34
                else:
                    cur_bear_variant = 32
            elif cur_bear_engulf:
                cur_bear_pattern = 1
                cur_bear_variant = 12
                cur_bear_break = cur_low
                cur_bear_stop = cur_high + cur_atr * 0.15
                cur_bear_marker = cur_high
            elif cur_bear_context and cur_lower_shape:
                cur_bear_pattern = 2
                cur_bear_variant = 23
                cur_bear_break = cur_low
                cur_bear_stop = cur_high + cur_atr * 0.15
                cur_bear_marker = cur_high
            elif cur_bear_context and cur_upper_shape:
                cur_bear_pattern = 2
                cur_bear_variant = 24
                cur_bear_break = cur_low
                cur_bear_stop = cur_high + cur_atr * 0.15
                cur_bear_marker = cur_high

        cur_select = 0
        if cur_bull_pattern > 0 and cur_bear_pattern > 0:
            if cur_bull_trend > cur_bear_trend + 0.25:
                cur_select = 1
            elif cur_bear_trend > cur_bull_trend + 0.25:
                cur_select = -1
        elif cur_bull_pattern > 0:
            cur_select = 1
        elif cur_bear_pattern > 0:
            cur_select = -1

        if cur_select > 0:
            cur_direction = 1
            cur_pattern = cur_bull_pattern
            cur_variant = cur_bull_variant
            cur_break_level = cur_bull_break
            cur_stop_level = cur_bull_stop
            cur_marker_level = cur_bull_marker
            cur_atr_feature = cur_atr
            cur_volume_feature = cur_volume_ratio
            cur_trend_feature = cur_bull_trend
            cur_location_feature = (cur_low - cur_swing_low) / cur_atr
        elif cur_select < 0:
            cur_direction = -1
            cur_pattern = cur_bear_pattern
            cur_variant = cur_bear_variant
            cur_break_level = cur_bear_break
            cur_stop_level = cur_bear_stop
            cur_marker_level = cur_bear_marker
            cur_atr_feature = cur_atr
            cur_volume_feature = cur_volume_ratio
            cur_trend_feature = cur_bear_trend
            cur_location_feature = (cur_swing_high - cur_high) / cur_atr

        # Monitor the active forecast on the just-closed candle. Stop wins a
        # same-bar stop/target tie. The upper duration range is a hard expiry.
        if direction_state[0] != 0.0 and remaining_state[0] > 0.0:
            remaining_state[0] = remaining_state[0] - 1.0
            hit_stop = False
            hit_target = False
            if direction_state[0] > 0.0:
                if self.low[1] <= stop_state[0]:
                    hit_stop = True
                elif self.high[1] >= target_state[0]:
                    hit_target = True
            else:
                if self.high[1] >= stop_state[0]:
                    hit_stop = True
                elif self.low[1] <= target_state[0]:
                    hit_target = True
            end_code = 0.0
            if hit_stop:
                end_code = 2.0
            elif hit_target:
                end_code = 1.0
            elif remaining_state[0] <= 0.0:
                end_code = 4.0
            if end_code > 0.0:
                last_result_state[0] = end_code
                entry_state[0] = nan
                stop_state[0] = nan
                target_state[0] = nan
                direction_state[0] = 0.0
                remaining_state[0] = 0.0

        # Confirm a pending candidate using the first or second later closed candle.
        # Nearby raw patterns are ignored while a candidate is pending (merged).
        if pending_direction_state[0] != 0.0:
            pending_elapsed_state[0] = pending_elapsed_state[0] + 1.0
            confirmed_now = False
            if pending_direction_state[0] > 0.0 and self.close[1] > pending_break_state[0]:
                confirmed_now = True
            elif pending_direction_state[0] < 0.0 and self.close[1] < pending_break_state[0]:
                confirmed_now = True
            if confirmed_now:
                confirmed_signal = True
                signal_direction = int(pending_direction_state[0] + 0.5)
                signal_pattern = int(pending_pattern_state[0] + 0.5)
                signal_variant = int(pending_variant_state[0] + 0.5)
                signal_break = pending_break_state[0]
                signal_stop = pending_stop_state[0]
                signal_marker = pending_marker_state[0]
                signal_atr = pending_atr_state[0]
                signal_volume = pending_volume_state[0]
                signal_trend = pending_trend_state[0]
                signal_location = pending_location_state[0]
                signal_entry = self.close[1]
                if signal_direction > 0:
                    confirmed_bull_marker = self.low[1]
                else:
                    confirmed_bear_marker = self.high[1]
                if direction_state[0] != 0.0 and remaining_state[0] > 0.0:
                    if float(signal_direction) != direction_state[0]:
                        last_result_state[0] = 3.0
                    else:
                        last_result_state[0] = 5.0
                    entry_state[0] = nan
                    stop_state[0] = nan
                    target_state[0] = nan
                    direction_state[0] = 0.0
                    remaining_state[0] = 0.0
                pending_direction_state[0] = 0.0
                pending_break_state[0] = nan
                pending_stop_state[0] = nan
                pending_pattern_state[0] = 0.0
                pending_variant_state[0] = 0.0
                pending_atr_state[0] = 0.0
                pending_volume_state[0] = 1.0
                pending_trend_state[0] = 0.0
                pending_location_state[0] = 0.0
                pending_elapsed_state[0] = 0.0
                pending_marker_state[0] = nan
                last_direction_state[0] = float(signal_direction)
                last_pattern_state[0] = float(signal_pattern)
                last_variant_state[0] = float(signal_variant)
                skip_new_candidate_bar = True
            elif pending_elapsed_state[0] >= float(confirmation_bars):
                pending_direction_state[0] = 0.0
                pending_break_state[0] = nan
                pending_stop_state[0] = nan
                pending_pattern_state[0] = 0.0
                pending_variant_state[0] = 0.0
                pending_atr_state[0] = 0.0
                pending_volume_state[0] = 1.0
                pending_trend_state[0] = 0.0
                pending_location_state[0] = 0.0
                pending_elapsed_state[0] = 0.0
                pending_marker_state[0] = nan
                skip_new_candidate_bar = True

        # Historical analogs use the SAME pattern families, context and two-bar
        # confirmation rule. Only episodes whose whole outcome window is past are used.
        if confirmed_signal and signal_atr > 0.0 and not isnan(signal_stop):
            history_end = history_bars
            available_history = self.bar_count - context_length - 1
            if available_history < history_end:
                history_end = available_history
            history_start = max_horizon + confirmation_bars + 3
            last_analog_offset = -1000000
            if history_start < history_end and history_end > 0:
                for i in range(history_start, history_end):
                    hist_open = self.open[i]
                    hist_high = self.high[i]
                    hist_low = self.low[i]
                    hist_close = self.close[i]
                    hist_prior_open = self.open[i + 1]
                    hist_prior_close = self.close[i + 1]
                    hist_first_open = self.open[i + 2]
                    hist_first_high = self.high[i + 2]
                    hist_first_low = self.low[i + 2]
                    hist_first_close = self.close[i + 2]
                    hist_middle_open = self.open[i + 1]
                    hist_middle_high = self.high[i + 1]
                    hist_middle_low = self.low[i + 1]
